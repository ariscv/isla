(declare-const path_a (_ BitVec 2))
(declare-const path_z (_ BitVec 2))
(and (= path_a #b01) (= path_z #b01))
(and (= path_a #b01) (= path_z #b10))
(and (= path_a #b01) (= path_z #b11))
(and (= path_a #b10) (= path_z #b01))
(and (= path_a #b10) (= path_z #b10))
(and (= path_a #b10) (= path_z #b11))
(and (= path_a #b11) (= path_z #b01))
(and (= path_a #b11) (= path_z #b10))
(and (= path_a #b11) (= path_z #b11))
